{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      }
    ]
  },
  "Seq": {
    "ServerUrl": ""
  },
  "MigrationAgentAuthentication": {
    "RenewalMarginSeconds": 120,
    "Retry": {
      "BaseDelaySeconds": 1,
      "MaxDelaySeconds": 60,
      "JitterPercent": 20
    }
  }
}
