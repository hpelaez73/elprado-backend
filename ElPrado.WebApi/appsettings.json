{
  "Logging": {
    "LogLevel": {
      "Default": "Error",
      "Microsoft.AspNetCore": "Error"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Key": "OrigenSecretsKeyOrigenSecretsKey",
    "Issuer": "https://localhost:44326"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Warning"
    },
    "WriteTo": [
      {
        "Name": "Seq",
        "Args": {
          "serverUrl": "http://210.1.1.185:5341"
        }
      }
    ],
    "Filter": [
      {
        "Name": "ByExcluding",
        "Args": {
          "expression": "SourceContext = 'Microsoft.AspNetCore.DataProtection'"
        }
      }
    ]
  },
  "PdfSettings": {
    "BasePath": "/var/appdata/pdfs"
  },
  "ImagenSettings": {
    "BasePath": "/var/appdata/imagenes",
    "BaseUrl": "https://api.elprado.com.ar/api"
  }
}
